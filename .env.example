# Copy to .env. Everything is optional: the defaults run against a local dev server with mock models.

# Temporal. Local dev server by default. For Temporal Cloud, set all three (API key auth turns TLS on).
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
TEMPORAL_UI_URL=http://localhost:8233

# Agent platform models: mock (deterministic, no keys) or real (Claude through langchain-anthropic).
PLATFORM_MODEL_MODE=mock
PLATFORM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# How long the durable tool waits for a person before it releases the hold and reports a timeout.
APPROVAL_TIMEOUT_S=300

# Tool interface mode at startup: temporal or direct. The dashboard switches it at runtime.
TOOL_MODE=temporal
